# /etc/pdp11/pdp11d.env: settings of the PDP-11/70 appliance (pdp11d).
#
# Read by pdp11d.service (systemd EnvironmentFile=) and by pdp11d-run, which
# follows systemd's rules. One KEY=value per line. Put a value that contains
# spaces, quotes, backslashes or $ in single quotes: PDP11_PASSWORD='a$b\c'.
# systemd takes '...' literally, but drops a backslash in an unquoted value
# and before " \ ` $ in a "..." value; for a single quote write "it's".
# After a change: systemctl restart pdp11d (a running guest OS is shut down
# cleanly first). Every setting is described in README.md, "Configuration".

# HTTP listen address, [host]:port. Ports below 1024 work too (the service
# has CAP_NET_BIND_SERVICE).
PDP11_LISTEN=:8080

# Password for the web UI, the API and the WebSocket (HTTP Basic auth, any
# user name). Empty: no authentication; anyone who can reach the port can
# control the machine, and the UI shows a warning banner.
PDP11_PASSWORD=

# Without a password, the host names under which the UI may be opened, in
# addition to IP addresses, localhost and this machine's own name (comma
# list; *.example.com matches every subdomain; * turns the check off). It
# stops web pages from reaching the machine through DNS rebinding.
#PDP11_HOSTS=pdp11.example.com

# Time zone of the date and time that RT-11, RSX, RSTS and UNIX V7 get typed
# in at boot (default: the system's time zone, timedatectl).
#TZ=Europe/Zurich

# System selected on the very first start (default: the catalog default,
# 2.11BSD). Later changes are made in the UI.
#PDP11_SYSTEM=bsd211

# Hobbyist-licensed systems (rt11, rsx11mp, rsts) whose licence you accept,
# so that they install without the UI's licence dialog (comma list).
#PDP11_ACCEPT_LICENSES=

# Telnet listener for the extra terminal lines of 2.11BSD and RSX-11M-PLUS,
# e.g. :4000. UNAUTHENTICATED: anyone who reaches it gets a login prompt, and
# 2.11BSD's root has no password.
#PDP11_TTY_TELNET=:4000

# Extra allowed WebSocket Origin hosts (comma list of host[:port] patterns)
# for a reverse proxy that does not pass the original Host header.
#PDP11_ALLOW_ORIGINS=pdp11.example.com

# Reverse proxies (comma list of addresses or CIDRs) whose X-Forwarded-For
# is trusted: the failed-login limit and the log then see the client's
# address instead of the proxy's.
#PDP11_TRUSTED_PROXIES=127.0.0.1,::1

# Pages that may show the UI in a frame (CSP frame-ancestors source list,
# e.g. for a kiosk view in a dashboard; default 'self').
#PDP11_FRAME_ANCESTORS="'self' https://dashboard.example.com"

# Answer GET /api/status without the password (for health checks).
#PDP11_HEALTH_PUBLIC=false

# Power on at start if the key switch was left at POWER or LOCK.
#PDP11_AUTOSTART=true

# On stop, type the guest OS's shutdown script before powering off (the
# service sets 1).
#PDP11_SHUTDOWN_ON_STOP=1

# Log level: debug, info, warn, error.
#PDP11_LOG=info
