--- a/PDP11/CMakeLists.txt
+++ b/PDP11/CMakeLists.txt
@@ -66,6 +66,7 @@ add_simulator(pdp11
         pdp11_tv.c
         pdp11_mb.c
         pdp11_rr.c
+        pdp11_panel.c
         ${DISPLAYNG}
         ${DISPLAYVT}
     INCLUDES
@@ -95,6 +96,7 @@ add_simulator(uc15
         ${UC15D}/pdp11_stddev.c
         ${UC15D}/pdp11_sys.c
         ${UC15D}/pdp11_uc15.c
+        ${UC15D}/pdp11_panel.c
     INCLUDES
