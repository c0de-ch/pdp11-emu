diff --git a/PDP11/pdp11_cpu.c b/PDP11/pdp11_cpu.c
index 85f08c3..c2606d9 100644
--- a/PDP11/pdp11_cpu.c
+++ b/PDP11/pdp11_cpu.c
@@ -244,6 +244,7 @@
 
 #include "pdp11_defs.h"
 #include "pdp11_cpumod.h"
+#include "pdp11_panel.h"
 
 #define PCQ_SIZE        64                              /* must be 2**n */
 #define PCQ_MASK        (PCQ_SIZE - 1)
@@ -728,6 +729,7 @@ t_stat sim_instr (void)
 int abortval, i;
 volatile int32 trapea;                                  /* used by setjmp */
 InstHistory *hst_ent = NULL;
+int32 panel_cd;                                         /* PANEL: countdown */
 
 sim_vm_pc_value = &pdp11_pc_value;
 
@@ -761,6 +763,7 @@ MMR0 = MMR0 & ~MMR0_IC;                                 /* usually off */
 trap_req = calc_ints (ipl, trap_req);                   /* upd int req */
 trapea = 0;
 reason = 0;
+panel_enter ();                                         /* PANEL: running */
 
 /* Abort handling
 
@@ -834,6 +837,7 @@ else {
    for stop condition.  If interrupt, locate the vector.
 */ 
 
+panel_cd = panel_rearm ();                              /* PANEL: (re)arm */
 while (reason == 0)  {
 
     int32 IR, srcspec, srcreg, dstspec, dstreg;
@@ -882,6 +886,8 @@ while (reason == 0)  {
                 if ((t >> trapnum) & 1) {               /* trap set? */
                     trapea = trap_vec[trapnum];         /* get vec, clr */
                     trap_req = trap_req & ~trap_clear[trapnum];
+                    if (trapnum <= TRAP_V_MME)          /* PANEL: red stack, odd */
+                        panel_trap ();                  /* addr, NXM, MMU = ADRS ERR */
                     if ((stop_trap >> trapnum) & 1)     /* stop on trap? */
                         reason = trapnum + 1;
                     break;
@@ -953,10 +959,21 @@ while (reason == 0)  {
     if (tbit)
         setTRAP (TRAP_TRC);
     if (wait_state) {                                   /* wait state? */
-        sim_idle (TMR_CLK, TRUE);
+        if ((--panel_wcountdown <= 0) && panel_wait (FALSE))
+            continue;                                   /* PANEL: halt requested */
+        if (sim_idle (TMR_CLK, TRUE))                   /* idled? */
+            panel_wait (TRUE);                          /* PANEL: sample the sleep */
         continue;
         }
 
+    if (--panel_cd <= 0) {                              /* PANEL: sample the */
+        panel_cd = panel_sample ();                     /* last instruction */
+        if (reason != 0) {                              /* halt requested? */
+            trap_req = trap_req & ~TRAP_TRC;            /* T bit trap: after */
+            break;                                      /* the next instr */
+            }
+        }
+    panel_bus = 0;                                      /* PANEL: no cycle yet */
     reg_mods = 0;
     inst_pc = PC;
     /* Save PSW also because condition codes need to be preserved.  We
@@ -2445,6 +2462,7 @@ STACKFILE[cm] = SP;
 saved_PC = PC & 0177777;
 pcq_r->qptr = pcq_p;                                    /* update pc q ptr */
 set_r_display (rs, cm);
+panel_exit (panel_cd);                                  /* PANEL: halted */
 return reason;
 }
 
@@ -2657,6 +2675,7 @@ int32 ReadW (int32 va)
 {
 int32 pa;
 
+PANEL_VA (va);                                          /* PANEL: bus capture */
 if ((va & 1) && CPUT (HAS_ODD)) {                       /* odd address? */
     setCPUERR (CPUE_ODD);
     ABORT (TRAP_ODD);
@@ -2673,6 +2692,7 @@ int32 ReadB (int32 va)
 {
 int32 pa;
 
+PANEL_VA (va);                                          /* PANEL: bus capture */
 pa = relocR (va);                                       /* relocate */
 if (BPT_SUMM_RD &&
     (sim_brk_test (va & 0177777, BPT_RDVIR) ||
@@ -2688,6 +2708,7 @@ int32 ReadCW (int32 va)
 {
 int32 pa;
 
+PANEL_VA (va);                                          /* PANEL: bus capture */
 if ((va & 1) && CPUT (HAS_ODD)) {                       /* odd address? */
     setCPUERR (CPUE_ODD);
     ABORT (TRAP_ODD);
@@ -2702,6 +2723,7 @@ return PReadW (pa);
 
 int32 ReadMW (int32 va)
 {
+PANEL_VA (va);                                          /* PANEL: bus capture */
 if ((va & 1) && CPUT (HAS_ODD)) {                       /* odd address? */
     setCPUERR (CPUE_ODD);
     ABORT (TRAP_ODD);
@@ -2716,6 +2738,7 @@ return PReadW (last_pa);
 
 int32 ReadMB (int32 va)
 {
+PANEL_VA (va);                                          /* PANEL: bus capture */
 last_pa = relocW (va);                                  /* reloc, wrt chk */
 if (BPT_SUMM_RW &&
     (sim_brk_test (va & 0177777, BPT_RWVIR) ||
@@ -2728,8 +2751,11 @@ int32 PReadW (int32 pa)
 {
 int32 data;
 
-if (ADDR_IS_MEM (pa))                                   /* memory address? */
-    return RdMemW (pa);
+if (ADDR_IS_MEM (pa)) {                                 /* memory address? */
+    data = RdMemW (pa);
+    PANEL_BUS (pa, data, 0);                            /* PANEL: bus capture */
+    return data;
+    }
 if (pa < IOPAGEBASE) {                                  /* not I/O address? */
     setCPUERR (CPUE_NXM);
     ABORT (TRAP_NXM);
@@ -2738,6 +2764,7 @@ if (iopageR (&data, pa, READ) != SCPE_OK) {             /* invalid I/O addr? */
     setCPUERR (CPUE_TMO);
     ABORT (TRAP_NXM);
     }
+PANEL_BUS (pa, data, PNL_IOPAGE);                       /* PANEL: bus capture */
 return data;
 }
 
@@ -2745,8 +2772,11 @@ int32 PReadB (int32 pa)
 {
 int32 data;
 
-if (ADDR_IS_MEM (pa))                                   /* memory address? */
-    return RdMemB (pa);
+if (ADDR_IS_MEM (pa)) {                                 /* memory address? */
+    data = RdMemB (pa);
+    PANEL_BUS (pa, data, PNL_BYTE);                     /* PANEL: bus capture */
+    return data;
+    }
 if (pa < IOPAGEBASE) {                                  /* not I/O address? */
     setCPUERR (CPUE_NXM);
     ABORT (TRAP_NXM);
@@ -2755,7 +2785,9 @@ if (iopageR (&data, pa, READ) != SCPE_OK) {             /* invalid I/O addr? */
     setCPUERR (CPUE_TMO);
     ABORT (TRAP_NXM);
     }
-return ((pa & 1)? data >> 8: data) & 0377;
+data = ((pa & 1)? data >> 8: data) & 0377;
+PANEL_BUS (pa, data, PNL_BYTE | PNL_IOPAGE);            /* PANEL: bus capture */
+return data;
 }
 
 /* Write byte and word routines
@@ -2771,6 +2803,7 @@ void WriteW (int32 data, int32 va)
 {
 int32 pa;
 
+PANEL_VA (va);                                          /* PANEL: bus capture */
 if ((va & 1) && CPUT (HAS_ODD)) {                       /* odd address? */
     setCPUERR (CPUE_ODD);
     ABORT (TRAP_ODD);
@@ -2787,6 +2820,7 @@ void WriteB (int32 data, int32 va)
 {
 int32 pa;
 
+PANEL_VA (va);                                          /* PANEL: bus capture */
 pa = relocW (va);                                       /* relocate */
 if (BPT_SUMM_WR &&
     (sim_brk_test (va & 0177777, BPT_WRVIR) ||
@@ -2802,6 +2836,7 @@ void WriteCW (int32 data, int32 va)
 {
 int32 pa;
 
+PANEL_VA (va);                                          /* PANEL: bus capture */
 if ((va & 1) && CPUT (HAS_ODD)) {                       /* odd address? */
     setCPUERR (CPUE_ODD);
     ABORT (TRAP_ODD);
@@ -2818,6 +2853,7 @@ void PWriteW (int32 data, int32 pa)
 {
 if (ADDR_IS_MEM (pa)) {                                 /* memory address? */
     WrMemW (pa, data);
+    PANEL_BUS (pa, data, PNL_WR);                       /* PANEL: bus capture */
     return;
     }
 if (pa < IOPAGEBASE) {                                  /* not I/O address? */
@@ -2828,6 +2864,7 @@ if (iopageW (data, pa, WRITE) != SCPE_OK) {             /* invalid I/O addr? */
     setCPUERR (CPUE_TMO);
     ABORT (TRAP_NXM);
     }
+PANEL_BUS (pa, data, PNL_WR | PNL_IOPAGE);              /* PANEL: bus capture */
 return;
 }
 
@@ -2835,6 +2872,7 @@ void PWriteB (int32 data, int32 pa)
 {
 if (ADDR_IS_MEM (pa)) {                                 /* memory address? */
     WrMemB (pa, data);
+    PANEL_BUS (pa, data & 0377, PNL_WR | PNL_BYTE);     /* PANEL: bus capture */
     return;
     }             
 if (pa < IOPAGEBASE) {                                  /* not I/O address? */
@@ -2845,6 +2883,7 @@ if (iopageW (data, pa, WRITEB) != SCPE_OK) {            /* invalid I/O addr? */
     setCPUERR (CPUE_TMO);
     ABORT (TRAP_NXM);
     }
+PANEL_BUS (pa, data & 0377, PNL_WR | PNL_BYTE | PNL_IOPAGE); /* PANEL: bus capture */
 return;
 }
 
