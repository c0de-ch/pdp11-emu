# Settings for compose.yaml: copy this file to .env and edit it.
# docker compose reads .env from the project directory; keep it private.
#
# Compose expands $ in these values, also inside double quotes: put a value
# with $ in single quotes (PDP11_PASSWORD='pa$w0rd') or write every $ as $$
# (PDP11_PASSWORD=pa$$w0rd). Unquoted, PDP11_PASSWORD=$ecret becomes an empty
# password, which turns authentication off.

# Password for the web UI, the API and the WebSocket (HTTP Basic auth, any
# user name). Empty: no authentication, anyone who can reach the port controls
# the machine, and the UI shows a warning banner.
PDP11_PASSWORD=

# Host port (or address:port, e.g. 127.0.0.1:8080) for the web UI. Docker
# publishes it past the host's firewall (ufw, firewalld): with the default and
# no password the machine is open to every network that reaches this host.
PDP11_HTTP_PORT=8080

# Without a password, pdp11d answers only requests for IP addresses,
# localhost, the container's own name (its id) and the host names listed here
# (comma list; *.example.com matches every subdomain, * turns the check off):
# this stops web pages from reaching the machine through DNS rebinding. List
# the names you open the UI with.
PDP11_HOSTS=

# Reverse proxies (comma list of addresses or CIDRs) whose X-Forwarded-For is
# trusted, so that the failed-login limit and the log see the client.
PDP11_TRUSTED_PROXIES=

# Pages that may show the UI in a frame (CSP frame-ancestors source list;
# empty: only the UI itself). Double quotes keep the single quotes:
# PDP11_FRAME_ANCESTORS="'self' https://dashboard.example.com"
PDP11_FRAME_ANCESTORS=

# Time zone for the date and time typed into the guests' boot dialogues.
TZ=Etc/UTC

# Host port for the telnet terminal lines (see compose.yaml: uncomment the
# port mapping and PDP11_TTY_TELNET there).
PDP11_TTY_PORT=4000
